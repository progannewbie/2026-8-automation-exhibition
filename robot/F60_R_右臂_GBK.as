.END
.PROGRAM split_csv(.$line) #33470
	FOR i = 1 TO 8
		$fld[i] = ""
	END
	nfld = 0
	$rest = .$line
	DO
		p = INSTR (1 , $rest , ",")
		nfld = nfld + 1
		IF p == 0 THEN
			$fld[nfld] = $rest
			$rest = ""
		ELSE
			$fld[nfld] = $LEFT ($rest, p - 1)
			$rest = $MID ($rest, p + 1, LEN ($rest) - p)
		END
	UNTIL $rest == "" OR nfld >= 8
.END
