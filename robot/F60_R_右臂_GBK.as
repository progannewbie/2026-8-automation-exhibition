.PROGRAM do_flip(.cycles,.speed_pct) #10
	IF .cycles < 1 OR .cycles > 20 THEN
		CALL send_line ("ERROR,E4005")
		RETURN
	END
	IF .speed_pct < 1 OR .speed_pct > 100 THEN
		CALL send_line ("ERROR,E4005")
		RETURN
	END
	ABS.SPEED ON
	robot_busy = 1
	SPEED 600 MM/s ALWAYS
	JMOVE #flip_end
	SPEED 600 MM/s ALWAYS
	JMOVE #flip_ready
	BASE ba_flip
	TOOL ha_flip
	break
	PULSE 1, 0.1
	i = 0
	DO
		; 階段 1：90°/90° 配對
		CALL do_con90 (ok)
		IF ok == 0 THEN
			CALL send_line ("ERROR,E4023")
			BASE ba
			TOOL right_spatula
			robot_busy = 0
			RETURN
		END
		; 階段 2：135°/45° 配對 (本臂45°)
		CALL do_rturn45 (ok)
		IF ok == 0 THEN
			CALL send_line ("ERROR,E4023")
			BASE ba
			TOOL right_spatula
			robot_busy = 0
			RETURN
		END
		; 階段 3：45°/135° 配對 (本臂 135°)
		CALL do_rturn135 (ok)
		IF ok == 0 THEN
			CALL send_line ("ERROR,E4023")
			BASE ba
			TOOL right_spatula
			robot_busy = 0
			RETURN
		END
		i = i + 1
	UNTIL i >= .cycles
	; 階段 1：90°/90° 配對
	CALL do_con135 (ok)
	IF ok == 0 THEN
		CALL send_line ("ERROR,E4023")
		BASE ba
		TOOL right_spatula
		robot_busy = 0
		RETURN
	END
	; 階段 2：135°/45° 配對 (本臂 45°)
	CALL do_con45 (ok)
	IF ok == 0 THEN
		CALL send_line ("ERROR,E4023")
		BASE ba
		TOOL right_spatula
		robot_busy = 0
		RETURN
	END
	; 階段 3：45°/135° 配對 (本臂 135°)
	CALL do_con90 (ok)
	IF ok == 0 THEN
		CALL send_line ("ERROR,E4023")
		BASE ba
		TOOL right_spatula
		robot_busy = 0
		RETURN
	END
	SPEED 600 MM/s ALWAYS
	LMOVE #flip_ready
	break
	SPEED 600 MM/s ALWAYS
	JMOVE #flip_end
	break
	BASE ba
	TOOL right_spatula
	JMOVE home_right
	break
	ABS.SPEED OFF
	robot_busy = 0
	CALL send_line ("OK")
.END
