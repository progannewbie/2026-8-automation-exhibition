	LINEAR SPEED9 ACCU1 TIMER0 TOOL1 WORK0 CLAMP1 (OFF,0,0,O) 2 (OFF,0,0,O) OX= WX= #[31.13,-5.3719,-73.275,117.25,43.41,-35.384] ;
