  ;CALL SYNC_STEP (ok); 直奂
  ;IF ok == 0 THEN
  ;  CALL SEND_LINE ("ERROR,E4023")
  ;  robot_busy = 0
  ;  RETURN
  ;END
  ;抬升
  ;LMOVE level2_up
  ;BREAK
  ;IF ok == 0 THEN
  ;  CALL SEND_LINE ("ERROR,E4023")
  ;  robot_busy = 0
  ;  RETURN
  ;END
  LMOVE HOME_RIGHT
  CALL SYNC_STEP (ok); 直奂
  IF ok == 0 THEN
    CALL SEND_LINE ("ERROR,E4023")
    robot_busy = 0
    RETURN
  END
  robot_busy = 0
  CALL SEND_LINE ("OK")
.END
