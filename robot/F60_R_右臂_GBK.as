    DRAW 0, 0, press_mm; 抬升
    DRAW .thick, 0, 0; 後退一步
    i = i + 1
  UNTIL i >= .cuts
  ;廢料去除
  LMOVE level_per;準備點上方
  break
  LMOVE level_tg;下降準備點
  break
  CALL SYNC_STEP (ok);已到點位
  IF ok == 0 THEN
    CALL SEND_LINE ("ERROR,E4023")
    robot_busy = 0
    RETURN
  END
  ;
  LMOVE level_ho;集中
