.PROGRAM lcon120() #28
	; *******************************************************************
	; 从上层往中间集中
	; *******************************************************************
	;
	10
	PRINT "lcon120"
	CALL init1222
	20
	SPEED sp3 MM/s
	ABS.SPEED ON
	CASE stp OF
		VALUE 8:;con30
			stp = 6
			SPEED sp3 MM/s
			LMOVE icon60_ready;准备点
			break
			stp = 3
			SPEED sp3 MM/s
			LMOVE lturn90_ready;准备点
			break
			stp = 11
			SPEED sp3 MM/s
			LMOVE icon120_ready;准备点
			break
		VALUE 3, 4, 5, 6, 10, 11:;turn 45,90,135 con 60,90,120
			stp = 11
			SPEED sp3 MM/s
			LMOVE icon120_ready;准备点
			break
	END
	stp = 11
	LMOVE icon120_ready;准备点
	break
	st = 4
	SPEED sp3 MM/s
	LMOVE icon120_down;下降
	break
	SPEED sp3 MM/s
