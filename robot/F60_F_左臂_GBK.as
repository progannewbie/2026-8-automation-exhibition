.PROGRAM ethernet_test() #0
	; *******************************************************************
	; 利用EtherNET通讯协定取得字串来呼叫程式
	; *******************************************************************
	;
	er = 0
	IF er == 1 THEN
		CALL break
	END
	break
	try = 0
	port = 9000
	max_len = 64
	tout_open = 60
	tout_rec = 5
	sock_id = -1
	r1 = 0
	max_length = 255
	; RPi ip
	ip[1] = 192
	ip[2] = 168
	ip[3] = 5
	ip[4] = 1
	10
	PRINT "Connecting.."
	TCP_CONNECT sock_id, port, ip[1], tout_open
	IF sock_id < 0 THEN
		PRINT "TCP_CONNECT failed, code=", sock_id
		GOTO 1000
	END
	PRINT "Connected. sock_id=", sock_id
	rsock_id = sock_id
	er = 1
	break
	; ---- 接收一段字串 ----
	.n = 1
	$kp[1] = "ok\n"
	break
	TCP_SEND r1, rsock_id, $kp[1], .n, tout_rec
	break
	20
	.n = max_len
	break
	TCP_RECV r1, sock_id, $buf[1], .n, tout_rec, max_length
	r1_1 = r1
	rsock_id = sock_id
	$st1 = $buf[1]
	IF $buf[1] == "" THEN
		GOTO 20
	END
	PRINT $st1
	break
	$st1_1[1] = $DECODE ($buf[1], ",", 0)
	$st1_1[2] = $DECODE ($buf[1], ",", 1)
	$st1_1[3] = $DECODE ($buf[1], ",", 0)
	PRINT $st1_1[3]
	$buf[1] = ""
	SCALL $st1_1[3]
	.n = 1
	$kp[1] = "ok\n"
	break
	TCP_SEND r1_1, rsock_id, $kp[1], .n, tout_rec
	GOTO 20
	1000
	TCP_CLOSE rc, rsock_id
	PRINT "Closed."
.END
