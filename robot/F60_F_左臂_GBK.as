  ;POINT chop_spread_pt = work_chop_zone + TRANS (chop_spread_dx, chop_spread_dy, 0, 0, 0, 0)
  LMOVE chop_spread_pt
  ; 階段 5d: 抬起 — 兩臂抬起離開切割區
  POINT chop_depart_pt = SHIFT (chop_spread_pt BY 0, 0, appro_mm)
  LMOVE chop_depart_pt
.END
.PROGRAM arm_client() #0
	$arm_id = "F"        ; change to "R" on the cutting arm
	port = 10001         ; must match the PORT on the Pi server
	ip[1] = 192          ; Pi IP on eth0: 192.168.5.1
	ip[2] = 168
	ip[3] = 5
	ip[4] = 1
	max_length = 255
	tout_open = 10
	tout_rec = 10
	tout = 10
	count = 0
	;
	CALL open_socket
	IF sock_id < 0 THEN
		PRINT "cannot connect to Pi, exit."
		GOTO exit_end
	END
	;
	; send 5 messages, wait for Pi reply each time
	WHILE count < 5 DO
		count = count + 1
		$msg = "HELLO from " + $arm_id
		CALL send (eret, $msg)
		IF eret < 0 THEN
			GOTO exit
		END
		CALL recv
		IF rret < 0 THEN
			GOTO exit
		END
		PRINT "Pi reply: ", $recv_buf[1]
		TWAIT 1
	END
	;
exit:
	CALL close_socket
exit_end:
.END
.PROGRAM arm_dispatch() #10
	RESET
	$arm_id = "F"
	$ver = "v5"
	port = 10001
	ip[1] = 192
	ip[2] = 168
	ip[3] = 5
	ip[4] = 1
	max_length = 255
	tout_open = 10
	tout_rec = 60
	tout = 10
	timeout_code = -34024
	;
	CALL init
	CALL open_socket
	IF sock_id < 0 THEN
		PRINT "cannot connect to Pi, exit."
		GOTO exit_end
	END
	$msg = "ID," + $arm_id + "," + $ver
	CALL send (eret, $msg)
	;
loop:
	CALL recv
	IF rret == timeout_code THEN
		GOTO loop
	END
	IF rret < 0 THEN
		GOTO exit
	END
	$line = $recv_buf[1]
	;
	; ---- heartbeat ----
	IF $line == "PING" THEN
		PRINT "got PING"
		CALL send (eret, "PONG")
		GOTO loop
	END
	;
	; ---- parse "RUN,<id>,<dish>" ----
	$kw = $DECODE ($line, ",", 0)
	$t = $DECODE ($line, ",", 1)
	$id = $DECODE ($line, ",", 0)
	$t = $DECODE ($line, ",", 1)
	$dish = $line
	;
	IF $kw == "RUN" THEN
		; -------- DISPATCH: one line per dish --------
		IF $dish == "SPAM" THEN
			CALL fry_lunchmeat
		END
		IF $dish == "BURGER" THEN
			CALL fry_burger
		END
		$reply = "DONE," + $id
		CALL send (eret, $reply)
	END
	;
	GOTO loop
	;
exit:
	CALL close_socket
exit_end:
.END
.PROGRAM arm_responder() #154
	$arm_id = "F"        ; <-- change to "R" on the cutting arm
	$ver = "v2"          ; version tag (do not change)
	port = 10001
	ip[1] = 192          ; Pi IP on eth0: 192.168.5.1
	ip[2] = 168
	ip[3] = 5
	ip[4] = 1
	max_length = 255
	tout_open = 10
	tout_rec = 60
	tout = 10
	timeout_code = -34024 ; E4024 = TCP receive timeout (normal while idle)
	;
	PRINT "arm_responder ", $ver, " arm_id=", $arm_id
	CALL open_socket
	IF sock_id < 0 THEN
		PRINT "cannot connect to Pi, exit."
		GOTO exit_end
	END
	;
	; register: "ID,<role>,<version>"
	$msg = "ID," + $arm_id + "," + $ver
	CALL send (eret, $msg)
	;
	; responder loop: wait for a command, reply
loop:
	CALL recv
	IF rret == timeout_code THEN
		GOTO loop          ; timeout = no command yet -> keep waiting
	END
	IF rret < 0 THEN
		GOTO exit          ; real connection error -> end
	END
	$cmd = $recv_buf[1]
	;
	IF $cmd == "HOLD" THEN
		PRINT "got HOLD"
		TWAIT 1
		CALL send (eret, "HOLD_OK")
	END
	IF $cmd == "RELEASE" THEN
		PRINT "got RELEASE"
		TWAIT 1
		CALL send (eret, "RELEASE_OK")
	END
	IF $cmd == "START" THEN
		PRINT "got START"
		TWAIT 2
		CALL send (eret, "DONE")
	END
	;
	GOTO loop
	;
exit:
	CALL close_socket
exit_end:
.END
