# Kawasaki AS 程式：保持原始位元組（GBK 編碼、原本的換行），不讓 git 轉換
*.as -text diff

# 二進位檔
*.pt binary
*.jpg binary
*.pdf binary
*.docx binary

# Windows 啟動檔：cmd / PowerShell 要 CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# shell 腳本在 WSL 執行，一律 LF
*.sh text eol=lf

# 3D 模型
*.stl binary
*.step binary
*.ics binary

# ROS 2 的 Python 腳本在 WSL 直接執行，一律 LF
V2/ros2/**/*.py text eol=lf
